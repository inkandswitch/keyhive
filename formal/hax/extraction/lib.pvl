(*
  Run with:
    proverif -lib <hax>/hax-lib/proof-libs/proverif/primitives.pvl \
             -lib <hax>/hax-lib/proof-libs/proverif/result.pvl \
             -lib <hax>/hax-lib/proof-libs/proverif/cryptolib.pvl  \
             -lib missingdecl.pvl \
             -lib lib.pvl your_analysis.pv

  These libraries ship with hax.

  primitives.pvl declares the symbols this file uses but does not
  define: the public channel c, the construct_fail sink,
  bitstring_default and bitstring_err, the Some/None and True/False
  constructors, the nat_0 to nat_16 literal constants, and the
  rust_primitives, core, and hax_lib helpers.

  result.pvl models Result and its methods.
  This model was extracted without --result-errors: a Result is its
  Ok payload and producing an Err ends the trace, so error paths are
  pruned from the model.

  cryptolib.pvl is the shared Dolev-Yao crypto model (hash, AEAD,
  KDF, DH, KEM, signatures, MAC, serialization) that a crate wires
  itself to with #[hax_lib::proverif::replace_body("crypto__...")].
  It is needed whenever the crate does so, and harmless otherwise.

  missingdecl.pvl, extracted next to this file, declares every symbol
  this file uses that none of these libraries defines, such as string
  literals and integer literals above 16. Each is left abstract:
  replace its declaration by a definition — by hand or from another
  crate's extraction — or keep it as an ideal-functionality boundary.
*)

(* Only typechecks with result.pvl loaded. *)
letfun hax_result_model_check__keyhive_content() = hax_result_model__result.

(* src: keyhive_content/src/encrypted.rs:318:0-328:1 keyhive_content__encrypted__ContentDecryptError *)
(*  Why content did not decrypt. *)
fun keyhive_content__encrypted__ContentDecryptError__Decryption(): bitstring [data].
fun keyhive_content__encrypted__ContentDecryptError__NonceMismatch(): bitstring [data].
(*  `chacha20poly1305::Error` contains no details, and is an `Error` only with *)
(*  `std`, so it is not kept as a source. *)
(* src: keyhive_content/src/encrypted.rs:333:4-335:5 keyhive_content__encrypted__Impl_5__from *)
letfun keyhive_content__encrypted__Impl_5__from(wildcard: bitstring) =
  keyhive_content__encrypted__ContentDecryptError__Decryption().
(* src: keyhive_content/src/encrypted.rs:406:0-409:1 keyhive_content__encrypted__ChunkCipher *)
(*  A block's AEAD and nonce key, derived from its application key. *)
(* *)
(*  Each method is a primitive to `cargo hax`: its body is replaced by a *)
(*  symbol of `formal/hax/keyhive.pvl`, where the cipher is the application *)
(*  key it was derived from. *)
fun keyhive_content__encrypted__ChunkCipher__ChunkCipher(bitstring, bitstring): bitstring [data].
reduc forall v_0: bitstring, v_1: bitstring;
  keyhive_content__encrypted__ChunkCipher__ChunkCipher__aead(
    keyhive_content__encrypted__ChunkCipher__ChunkCipher(v_0, v_1)
  ) = v_0.
reduc forall v_0: bitstring, v_1: bitstring;
  keyhive_content__encrypted__ChunkCipher__ChunkCipher__nonce_key(
    keyhive_content__encrypted__ChunkCipher__ChunkCipher(v_0, v_1)
  ) = v_1.
(* src: keyhive_content/src/encrypted.rs:425:8-425:83 keyhive_content__encrypted__Impl_7__nonce *)
(*  The synthetic nonce: keyed BLAKE3 over the AAD and the plaintext. *)
letfun keyhive_content__encrypted__Impl_7__nonce(
  self: bitstring,
  aad: bitstring,
  chunk: bitstring
) = ks_mac(ks_kdf_nonce(self), (aad, chunk)).
(* src: keyhive_content/src/encrypted.rs:435:8-437:9 keyhive_content__encrypted__Impl_7__nonce_matches *)
(*  Whether `nonce` is the synthetic nonce of `plaintext`, compared in *)
(*  constant time. *)
letfun keyhive_content__encrypted__Impl_7__nonce_matches(
  self: bitstring,
  nonce: bitstring,
  aad: bitstring,
  plaintext: bitstring
) = if nonce = ks_mac(ks_kdf_nonce(self), (aad, plaintext)) then True else False.
(* src: keyhive_content/src/encrypted.rs:445:8-445:91 keyhive_content__encrypted__Impl_7__seal *)
letfun keyhive_content__encrypted__Impl_7__seal(
  self: bitstring,
  nonce: bitstring,
  aad: bitstring,
  chunk: bitstring
) = ks_aead_enc(ks_kdf_enc(self), nonce, aad, chunk).
(* src: keyhive_content/src/encrypted.rs:374:0-382:1 keyhive_content__encrypted__seal_chunk *)
(*  Seal one chunk: its synthetic nonce, then its ciphertext. *)
(* *)
(*  This and [`open_chunk`] are the construction `formal/hax/` proves *)
(*  key-committing: `cargo hax` extracts them as they are, and models the *)
(*  [`ChunkCipher`] primitives they call. *)
letfun keyhive_content__encrypted__seal_chunk(cipher: bitstring, aad: bitstring, chunk: bitstring) =
  let nonce = keyhive_content__encrypted__Impl_7__nonce(cipher, aad, chunk) in
  let hax__scrut0 = keyhive_content__encrypted__Impl_7__seal(cipher, nonce, aad, chunk) in
  let ciphertext = hax__scrut0 in rust_primitives__hax__Tuple2__Tuple2(nonce, ciphertext).
(* src: keyhive_content/src/encrypted.rs:467:8-467:96 keyhive_content__encrypted__Impl_7__open *)
(*  Decrypt one chunk, wiped when dropped. Does not check the nonce: see *)
(*  [`open_chunk`]. *)
letfun keyhive_content__encrypted__Impl_7__open(
  self: bitstring,
  nonce: bitstring,
  aad: bitstring,
  ciphertext: bitstring
) = ks_aead_dec(ks_kdf_enc(self), nonce, ciphertext, aad).
(* src: keyhive_content/src/encrypted.rs:387:0-399:1 keyhive_content__encrypted__open_chunk *)
(*  Open one chunk. It must authenticate, and its nonce must be the *)
(*  synthetic nonce of what it decrypts to: the check is what commits the *)
(*  chunk to one key, since the AEAD alone does not. *)
letfun keyhive_content__encrypted__open_chunk(
  cipher: bitstring,
  aad: bitstring,
  nonce: bitstring,
  ciphertext: bitstring
) =
  let hax__scrut0 = keyhive_content__encrypted__Impl_7__open(cipher, nonce, aad, ciphertext) in
  let plaintext = hax__scrut0 in
    let hax__cond1 = keyhive_content__encrypted__Impl_7__nonce_matches(
      cipher,
      nonce,
      aad,
      plaintext
    ) in
    let (=True()) = hax__cond1 in plaintext else bitstring_err().